<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <!-- Idiomas do app: o WebView passa a informar o idioma do sistema (navigator.language) e o macOS
       traduz os itens padrão. Textos traduzidos do Info.plist em locales/<idioma>.lproj/InfoPlist.strings. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>pt-BR</string>
  </array>
  <key>NSMicrophoneUsageDescription</key>
  <string>Kabul uses the microphone for dictation in the message field.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Kabul transcribes dictation into the message field.</string>
</dict>
</plist>
